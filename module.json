{
    "id": "npc-generator-dnd5e-eldore",
    "title": "NPC Generator for DnD5e (Eldore)",
    "description": "Generate D&D 5e NPCs with configurable HP, equipment, spells, portrait and token matching, and generic batches.",
    "version": "1.28.6",
    "authors": [],
    "url": "https://github.com/TaylorBeebe/foundry_npc_generator",
    "bugs": "https://github.com/TaylorBeebe/foundry_npc_generator/issues",
    "readme": "https://github.com/TaylorBeebe/foundry_npc_generator/blob/HEAD/CLAUDE.md",
    "changelog": "https://github.com/TaylorBeebe/foundry_npc_generator/blob/HEAD/CHANGELOG-eldore.md",
    "esmodules": [
        "main.js"
    ],
    "styles": [
        "style.css"
    ],
    "packs": [
        {
            "name": "features",
            "label": "Features",
            "path": "packs/features",
            "type": "Item",
            "system": "dnd5e",
            "flags": {},
            "ownership": {
                "ASSISTANT": "OWNER"
            }
        },
        {
            "name": "spells",
            "label": "Spells",
            "path": "packs/spells",
            "type": "Item",
            "system": "dnd5e",
            "flags": {},
            "ownership": {
                "ASSISTANT": "OWNER"
            }
        }
    ],
    "compatibility": {
        "minimum": 13,
        "verified": 14
    },
    "relationships": {
        "systems": [
            {
                "id": "dnd5e",
                "type": "system",
                "manifest": "https://raw.githubusercontent.com/foundryvtt/dnd5e/master/system.json",
                "compatibility": {
                    "verified": "5.3.3"
                }
            }
        ]
    }
}
